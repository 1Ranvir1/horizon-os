+    /** Background, read-only handoff. The enhancer saves a separate copy. */
+    private fun requestGtPhotoEnhancement(photo: Uri?) {
+        // Respect secure-camera boundaries and single-capture contracts.
+        if (photo == null || keyguardManager.isKeyguardLocked) return
+        val component = android.content.ComponentName(
+            "dev.gtos.photoenhancer", "dev.gtos.photoenhancer.EnhanceService"
+        )
+        val request = Intent("dev.gtos.photoenhancer.ENHANCE").apply {
+            this.component = component
+            data = photo
+            clipData = android.content.ClipData.newRawUri("Captured photo", photo)
+            addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+        }
+        try {
+            startForegroundService(request)
+        } catch (failure: RuntimeException) {
+            // An absent/disabled enhancer never breaks photo capture or gallery access.
+            android.util.Log.w("GTPhotoEnhance", "Enhancer unavailable; original saved", failure)
+        }
+    }
