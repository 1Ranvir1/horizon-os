+        launcher.getDragLayer().setAlpha(1 - progress * .12f);
+        int nextBlur = Math.round((float) Math.sin(Math.PI * progress) * 8);
+        if (nextBlur != blurStep) {
+            blurStep = nextBlur;
+            launcher.getDragLayer().setRenderEffect(nextBlur == 0 ? null : android.graphics.RenderEffect.createBlurEffect(
+                    nextBlur, nextBlur, android.graphics.Shader.TileMode.CLAMP));
+        }
+        if (callbacks != null) callbacks.onOverlayScrollChanged(progress);
+        if (progress == 0 && attached && !horizontal) {
+            windows.removeViewImmediate(web); attached = false;
+            page = 0;
+            web.evaluateJavascript("document.querySelector('.app-pages')?.scrollTo({left:0,behavior:'instant'})", null);
+        }
+    }
+    private void animateTo(float target, int duration) {
+        if (animator != null) animator.cancel();
+        animator = ValueAnimator.ofFloat(progress, target);
+        animator.setDuration(duration); animator.setInterpolator(new DecelerateInterpolator());
+        animator.addUpdateListener(a -> setProgress((float) a.getAnimatedValue())); animator.start();
+    }
+    @Override public void onFlingVelocity(float value) { velocity = value; }
+    @Override public void onOverlayMotionEvent(MotionEvent event, float scrollProgress) {
+        if (event.getActionMasked() == MotionEvent.ACTION_DOWN) {
+            if (animator != null) animator.cancel(); velocity = 0; closingRight = false; ensureView();
+        } else if (event.getActionMasked() == MotionEvent.ACTION_MOVE) setProgress(scrollProgress);
+        else if (event.getActionMasked() == MotionEvent.ACTION_UP) animateTo(
+                progress > .3f || (progress > .08f && Math.abs(velocity) > dp(700)) ? 1 : 0, 280);
+        else if (event.getActionMasked() == MotionEvent.ACTION_CANCEL) animateTo(0, 220);
+    }
+    @Override public void openOverlay() { animateTo(1, 280); }
+    @Override public void hideOverlay(boolean animate) { hideOverlay(animate ? 280 : 0); }
+    @Override public void hideOverlay(int duration) { if (web != null) animateTo(0, duration); }
+    @Override public void onActivityResumed() {
+        if (!launcher.getWorkspace().hasOverlay()) launcher.setLauncherOverlay(this);
+        if (web != null) web.onResume();
+    }
+    @Override public void dump(String prefix, java.io.PrintWriter writer) {
+        writer.println(prefix + "WeatherGPT overlay: attached=" + attached + " progress=" + progress
+                + " page=" + page + " registered=" + launcher.getWorkspace().hasOverlay());
+    }
+    @Override public void onActivityPaused() { if (web != null) web.onPause(); }
+    @Override public void onDetachedFromWindow() { hideOverlay(0); }
+    @Override public void onActivityDestroyed() {
+        destroyed = true;
+        if (animator != null) animator.cancel();
+        launcher.getDragLayer().setTranslationX(0); launcher.getDragLayer().setAlpha(1); launcher.getDragLayer().setRenderEffect(null);
+        if (attached) windows.removeViewImmediate(web);
+        if (web != null) { web.removeJavascriptInterface("GTOSSky"); web.stopLoading(); web.destroy(); }
+        web = null; attached = false;
+    }
+    public final class SkyBridge {
+        @JavascriptInterface public void navigation(int index) { if (index >= 0 && index <= 2) launcher.runOnUiThread(() -> {
+            if (android.os.SystemClock.uptimeMillis() >= navigatingUntil && !horizontal) page = index;
+        }); }
+        @JavascriptInterface public void update(String value) {
+            if (value.length() > 2048) return;
+            try {
+                JSONObject data = new JSONObject(value);
+                double lat = data.getDouble("latitude"), lon = data.getDouble("longitude");
+                if (!Double.isFinite(lat) || !Double.isFinite(lon) || Math.abs(lat) > 90 || Math.abs(lon) > 180) return;
+                String place = data.optString("place");
+                Intent intent = new Intent().setComponent(new ComponentName("dev.gtos.launcher", "dev.gtos.launcher.design.SkyUpdateReceiver"))
+                    .putExtra("latitude", lat).putExtra("longitude", lon).putExtra("place", place.substring(0, Math.min(100, place.length())))
+                    .putExtra("code", data.optInt("code", -1))
+                    .putExtra("wind", data.optDouble("wind", 0));
+                launcher.sendBroadcast(intent, null, BroadcastOptions.makeBasic().setShareIdentityEnabled(true).toBundle());
+            } catch (Exception ignored) { }
+        }
+    }
+    private static final String SCRIPT = """
+        (()=>{if(window.__gtosSkyConnected)return;window.__gtosSkyConnected=true;
+        const sync=()=>{try{if(typeof locationChoice==='undefined'||!locationChoice)return;
+          GTOSSky.update(JSON.stringify({latitude:locationChoice.latitude,longitude:locationChoice.longitude,
+          place:locationChoice.name,code:typeof forecast!=='undefined'?forecast?.current?.weather_code??-1:-1,
+          wind:typeof forecast!=='undefined'?forecast?.current?.wind_speed_10m??0:0}));}catch(_){}};
+        addEventListener('weather-location-changed',sync);addEventListener('weather-data-changed',sync);
+        const p=document.querySelector('.app-pages');const nav=()=>{if(p?.clientWidth)GTOSSky.navigation(Math.round(p.scrollLeft/p.clientWidth))};
+        p?.addEventListener('scroll',nav,{passive:true});nav();sync();})();
+        """;
+}
