+    public WeatherOverlay(Launcher launcher) {
+        this.launcher = launcher;
+        windows = launcher.getSystemService(WindowManager.class);
+        android.content.SharedPreferences prefs = com.android.launcher3.LauncherPrefs.getPrefs(launcher);
+        if (!prefs.getBoolean("gtos_weather_home_initialized", false)) prefs.edit()
+                .putBoolean(com.android.launcher3.SessionCommitReceiver.ADD_ICON_PREFERENCE_KEY, true)
+                .putBoolean("gtos_weather_home_initialized", true).apply();
+    }
+    @Override public void onAttachedToWindow() { launcher.setLauncherOverlay(this); }
+    @Override public void onActivityStarted() { launcher.getRootView().postDelayed(() -> { if (!destroyed) ensureView(); }, 500); }
+    @Override public void setOverlayCallbacks(LauncherOverlayCallbacks value) { callbacks = value; }
+    private void ensureView() {
+        if (web != null) return;
+        web = new WebView(launcher);
+        web.setBackgroundColor(0xff89b6dc);
+        web.getSettings().setJavaScriptEnabled(true);
+        web.getSettings().setDomStorageEnabled(true);
+        web.getSettings().setUseWideViewPort(true);
+        web.getSettings().setLoadWithOverviewMode(true);
+        web.getSettings().setAllowFileAccess(false);
+        web.getSettings().setAllowContentAccess(false);
+        web.getSettings().setGeolocationEnabled(false);
+        web.getSettings().setMixedContentMode(WebSettings.MIXED_CONTENT_NEVER_ALLOW);
+        web.addJavascriptInterface(new SkyBridge(), "GTOSSky");
+        web.setWebViewClient(new WebViewClient() {
+            @Override public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
+                Uri uri = request.getUrl();
+                if ("https".equals(uri.getScheme()) && HOST.equals(uri.getHost())) return false;
+                if (request.isForMainFrame() && ("https".equals(uri.getScheme()) || "http".equals(uri.getScheme()))) {
+                    try { launcher.startActivity(new Intent(Intent.ACTION_VIEW, uri)); } catch (RuntimeException ignored) { }
+                }
+                return request.isForMainFrame();
+            }
+            @Override public void onPageFinished(WebView view, String url) {
+                if (!HOST.equals(Uri.parse(url).getHost())) return;
+                view.evaluateJavascript(SCRIPT, null);
+            }
+        });
+        web.setOnApplyWindowInsetsListener((view, insets) -> {
+            android.graphics.Insets bars = insets.getInsets(android.view.WindowInsets.Type.systemBars());
+            android.graphics.Insets ime = insets.getInsets(android.view.WindowInsets.Type.ime());
+            view.setPadding(bars.left, bars.top, bars.right, Math.max(bars.bottom, ime.bottom));
+            return insets;
+        });
+        web.setOnTouchListener((view, event) -> {
+            if (event.getPointerCount() > 1) { horizontal = false; return false; }
+            switch (event.getActionMasked()) {
+                case MotionEvent.ACTION_DOWN:
+                    if (android.os.SystemClock.uptimeMillis() < navigatingUntil) web.evaluateJavascript(
+                            "document.querySelector('.app-pages')?.scrollTo({left:" + page
+                            + "*document.querySelector('.app-pages').clientWidth,behavior:'instant'})", null);
+                    downX = event.getRawX(); downY = event.getRawY(); horizontal = false; startProgress = progress; closingRight = false;
+                    return false;
+                case MotionEvent.ACTION_MOVE:
+                    float dx = event.getRawX() - downX, dy = event.getRawY() - downY;
+                    boolean mapEdge = downY < dp(100) || downX < dp(24) || downX > web.getWidth() - dp(24);
+                    if (!horizontal && Math.abs(dx) > dp(24) && Math.abs(dx) > Math.abs(dy) * 1.5f
+                            && downY < web.getHeight() * .85f) {
+                        horizontal = true;
+                        MotionEvent cancel = MotionEvent.obtain(event); cancel.setAction(MotionEvent.ACTION_CANCEL);
+                        web.onTouchEvent(cancel); cancel.recycle();
+                    }
+                    if (horizontal && page == 0 && dx > 0) { closingRight = true; setProgress(startProgress - dx / width()); }
+                    return horizontal;
+                case MotionEvent.ACTION_UP:
+                    if (!horizontal) return false;
+                    float drag = event.getRawX() - downX;
+                    if (page == 0 && drag > 0) animateTo(drag > dp(60) ? 0 : 1, 240);
+                    else if (Math.abs(drag) > dp(60)) {
+                        page = Math.max(0, Math.min(2, page + (drag < 0 ? 1 : -1)));
+                        navigatingUntil = android.os.SystemClock.uptimeMillis() + 500;
+                        web.evaluateJavascript("document.querySelector('.app-pages')?.scrollTo({left:" + page
+                                + "*document.querySelector('.app-pages').clientWidth,behavior:'smooth'})", null);
+                    }
+                    horizontal = false; return true;
+                case MotionEvent.ACTION_CANCEL:
+                    if (horizontal && progress < 1) animateTo(1, 220);
+                    horizontal = false; return false;
+                default: return horizontal;
+            }
+        });
+        web.setOnKeyListener((view, keyCode, event) -> {
+            if (keyCode == android.view.KeyEvent.KEYCODE_BACK && event.getAction() == android.view.KeyEvent.ACTION_UP) {
+                if (page > 0) { page--; web.evaluateJavascript("document.querySelector('.app-pages')?.scrollTo({left:"
+                    + page + "*document.querySelector('.app-pages').clientWidth,behavior:'smooth'})", null); }
+                else hideOverlay(true);
+                return true;
+            }
+            return false;
+        });
+        web.loadUrl("https://" + HOST + "/");
+    }
+    private int dp(int value) { return Math.round(value * launcher.getResources().getDisplayMetrics().density); }
+    private int width() { return Math.max(1, launcher.getRootView().getWidth()); }
+    private void setProgress(float value) {
+        progress = Math.max(0, Math.min(1, value));
+        ensureView();
+        if (progress > 0 && !attached) {
+            layout = new WindowManager.LayoutParams(width(), WindowManager.LayoutParams.MATCH_PARENT,
+                    WindowManager.LayoutParams.TYPE_APPLICATION_PANEL, WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
+                    | WindowManager.LayoutParams.FLAG_HARDWARE_ACCELERATED
+                    | WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE
+                    | WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE, PixelFormat.TRANSLUCENT);
+            layout.token = launcher.getWindow().getDecorView().getWindowToken();
+            layout.gravity = Gravity.TOP | Gravity.LEFT;
+            layout.setTitle("WeatherGPT Home panel");
+            windows.addView(web, layout); attached = true;
+        }
+        if (attached) {
+            web.setTranslationX((closingRight ? 1 - progress : progress - 1) * width());
+            web.setAlpha(progress * progress * (3 - 2 * progress));
+            int flags = WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN | WindowManager.LayoutParams.FLAG_HARDWARE_ACCELERATED
+                    | (progress < 1 ? WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE : 0)
+                    // Keep the Home finger stream until its release. A full-size moving
+                    // panel otherwise steals it as soon as the window is added.
+                    | (progress < 1 && !horizontal ? WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE : 0);
