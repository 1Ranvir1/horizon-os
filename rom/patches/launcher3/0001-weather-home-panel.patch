+package com.android.launcher3.uioverrides;
+
+import android.view.Gravity;
+import android.widget.LinearLayout;
+import android.widget.RelativeLayout;
+import android.widget.TextView;
+import com.android.launcher3.Launcher;
+import com.android.launcher3.allapps.AllAppsRecyclerView;
+import com.android.launcher3.allapps.BaseAllAppsAdapter;
+import java.util.List;
+
+/** Accessible letter buttons jump within the active personal/work/search catalog. */
+public final class AlphabetRail {
+    public static void install(Launcher launcher) {
+        float density = launcher.getResources().getDisplayMetrics().density;
+        LinearLayout rail = new LinearLayout(launcher); rail.setOrientation(LinearLayout.VERTICAL);
+        RelativeLayout.LayoutParams params = new RelativeLayout.LayoutParams(Math.round(28 * density), -1);
+        params.addRule(RelativeLayout.ALIGN_PARENT_END);
+        params.topMargin = Math.round(145 * density); params.bottomMargin = Math.round(42 * density);
+        launcher.getAppsView().addView(rail, params);
+        for (char letter : "#ABCDEFGHIJKLMNOPQRSTUVWXYZ".toCharArray()) {
+            TextView button = new TextView(launcher); button.setText(String.valueOf(letter));
+            button.setTextSize(11); button.setGravity(Gravity.CENTER);
+            button.setTextColor(0xff9eabc0); button.setContentDescription("Jump to " + letter);
+            rail.addView(button, new LinearLayout.LayoutParams(-1, 0, 1));
+            button.setOnClickListener(v -> {
+                AllAppsRecyclerView list = launcher.getAppsView().getActiveRecyclerView();
+                if (list == null || list.getApps() == null) return;
+                List<BaseAllAppsAdapter.AdapterItem> items = list.getApps().getAdapterItems();
+                for (int i = 0; i < items.size(); i++) {
+                    if (items.get(i).itemInfo == null) continue;
+                    String title = items.get(i).itemInfo.title.toString();
+                    if (title.isEmpty()) continue;
+                    char first = Character.toUpperCase(title.charAt(0));
+                    if ((letter == '#' && (first < 'A' || first > 'Z')) || first == letter) {
+                        if (list.getLayoutManager() instanceof androidx.recyclerview.widget.LinearLayoutManager manager) manager.scrollToPositionWithOffset(i, 0);
+                        else list.scrollToPosition(i);
+                        break;
+                    }
+                }
+            });
+        }
+    }
+}
