+/** Local WeatherGPT panel using the existing Trebuchet minus-one-page contract. */
+public final class WeatherOverlay implements LauncherOverlayManager,
+        LauncherOverlayManager.LauncherOverlayTouchProxy {
+    private static final String HOST = "weathergpt-7jyp.onrender.com";
+    private final Launcher launcher;
+    private final WindowManager windows;
+    private WebView web;
+    private WindowManager.LayoutParams layout;
+    private LauncherOverlayCallbacks callbacks;
+    private ValueAnimator animator;
+    private boolean attached;
+    private float progress, velocity, downX, downY, startProgress;
+    private int page;
+    private boolean horizontal;
+    private boolean closingRight;
+    private boolean destroyed;
+    private int blurStep = -1;
+    private long navigatingUntil;
