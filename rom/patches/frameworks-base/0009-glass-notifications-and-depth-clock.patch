+    private val clockRect = android.graphics.Rect()
+    private var lastTint = 0
+    private var lastFrame = 0L
+    private var clockView: android.view.View? = null
+
+    private fun findClock(group: android.view.ViewGroup): android.view.View? {
+        var largest: android.view.View? = null
+        for (i in 0 until group.childCount) {
+            val child = group.getChildAt(i)
+            if (!child.isShown) continue
+            val candidate = if (child is com.android.systemui.shared.clocks.AnimatableClockView) child
+                else if (child is android.view.ViewGroup) findClock(child) else null
+            if (candidate != null && candidate.width * candidate.height > (largest?.let { it.width * it.height } ?: 0)) largest = candidate
+        }
+        return largest
+    }
+
+    private fun drawClouds(canvas: android.graphics.Canvas, front: Boolean) {
+        val bitmap = cloud ?: return
+        val tint = context.getColor(android.R.color.system_accent1_100)
+        if (lastTint != tint) {
+            lastTint = tint
+            cloudPaint.colorFilter = android.graphics.ColorMatrixColorFilter(android.graphics.ColorMatrix(floatArrayOf(
+                android.graphics.Color.red(tint) / 255f, 0f, 0f, 0f, 0f,
+                0f, android.graphics.Color.green(tint) / 255f, 0f, 0f, 0f,
+                0f, 0f, android.graphics.Color.blue(tint) / 255f, 0f, 0f,
+                0f, 0f, 0f, 1f, 0f)))
+        }
+        val t = android.os.SystemClock.uptimeMillis() / 1000f
+        val exit = (1f - alpha).coerceIn(0f, 1f)
+        val cw = width * if (front) .64f else .85f
+        val ch = cw * bitmap.height / bitmap.width
+        for (i in 0..1) {
+            val base = width * (if (i == 0) .16f else .84f)
+            val cx = base + kotlin.math.sin(t * .025f + i * 2f) * width * .08f
+            val direction = if (cx < width / 2f) -1f else 1f
+            val x = cx + direction * exit * (width + cw) * .8f
+            val cy = if (front) clockRect.bottom - clockRect.height() * .20f
+                else height * (.12f + i * .055f)
+            cloudRect.set(x - cw / 2, cy - ch / 2, x + cw / 2, cy + ch / 2)
+            cloudPaint.alpha = if (front) 98 else 72
+            canvas.drawBitmap(bitmap, null, cloudRect, cloudPaint)
+        }
+    }
+
+    override fun dispatchDraw(canvas: android.graphics.Canvas) {
+        val active = depthEnabled && display?.state == android.view.Display.STATE_ON && isShown
+        if (!active) { super.dispatchDraw(canvas); return }
+        val now = android.os.SystemClock.uptimeMillis()
+        if (now - lastFrame > 300 || clockView?.isShown != true) {
+            clockView = findClock(this)
+            lastFrame = now
+        }
+        val clock = clockView
+        if (clock == null || clock.width == 0 || clock.height == 0) {
+            super.dispatchDraw(canvas)
+            return
+        }
+        clock.getDrawingRect(clockRect)
+        offsetDescendantRectToMyCoords(clock, clockRect)
+        drawClouds(canvas, false)
+        super.dispatchDraw(canvas)
+        val save = canvas.save()
+        // Only the lower portion of the clock receives foreground cloud occlusion.
+        // Notifications, date, status indicators and authentication controls stay clear.
+        canvas.clipRect(clockRect.left.toFloat(), clockRect.top + clockRect.height() * .68f, clockRect.right.toFloat(), clockRect.bottom.toFloat())
+        drawClouds(canvas, true)
+        canvas.restoreToCount(save)
+        if (android.animation.ValueAnimator.areAnimatorsEnabled()) postInvalidateDelayed(33)
+    }
+}
