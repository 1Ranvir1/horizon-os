+    // Device opt-in: show measured SA 5G power, capped by measured signal quality.
+    // This changes the display scale only; modem reports and network behavior stay intact.
+    private fun calibratedNrLevel(signal: SignalStrength): Int {
+        if (!context.resources.getBoolean(
+                com.android.systemui.res.R.bool.config_gtosCalibratedNrSignal) ||
+            telephonyManager.dataNetworkType != TelephonyManager.NETWORK_TYPE_NR) {
+            return signal.level
+        }
+        val nr = signal.getCellSignalStrengths(android.telephony.CellSignalStrengthNr::class.java)
+            .firstOrNull { it.ssRsrp in -140..-44 } ?: return signal.level
+        val power = when {
+            nr.ssRsrp >= -90 -> 4
+            nr.ssRsrp >= -100 -> 3
+            nr.ssRsrp >= -110 -> 2
+            nr.ssRsrp >= -120 -> 1
+            else -> 0
+        }
+        val quality = if (nr.ssSinr !in -23..40) 4 else when {
+            nr.ssSinr >= 20 -> 4
+            nr.ssSinr >= 10 -> 3
+            nr.ssSinr >= 5 -> 2
+            nr.ssSinr >= 0 -> 1
+            else -> 0
+        }
+        return minOf(power, quality)
+    }
+
