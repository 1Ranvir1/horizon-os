+        val body = position(d, latitude, longitude, m, true)
+        return Moon(body, (1 + cos(incidence)) / 2,
+            .5 + .5 * incidence * (if (angle < 0) -1 else 1) / PI, angle - body.parallacticAngle)
+    }
+}
