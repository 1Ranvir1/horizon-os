@@ -0,0 +1,155 @@
+package com.android.systemui.keyguard.ui.view
+
+import android.content.Context
+import android.graphics.*
+import android.net.Uri
+import android.os.SystemClock
+import android.view.View
+import java.util.concurrent.Executors
+import kotlin.math.*
+
+/** Sparse AOD counterpart of Home. Provider I/O stays off the SystemUI/UI thread. */
+internal class GtosAmbientSky(private val context: Context) {
+    private data class State(val latitude: Double, val longitude: Double, val epoch: Long)
+    @Volatile private var state: State? = null
+    @Volatile private var loading = false
+    private var lastRequest = -60_000L
+    private var generation = 0
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG or Paint.FILTER_BITMAP_FLAG)
+    private val path = Path()
+    private val rect = RectF()
+    private var moonBitmap: Bitmap? = null
+    private var moonKey = ""
+    private var minuteKey = -1L
+    private var sun: SkyAstronomy.Body? = null
+    private var moon: SkyAstronomy.Moon? = null
+    private val stars = java.util.Random(6739L).let { random ->
+        Array(70) { floatArrayOf(random.nextFloat(), random.nextFloat() * .8f,
+            .6f + random.nextFloat(), random.nextFloat() * 6.283f, .35f + random.nextFloat() * .5f) }
+    }
+
+    fun cancel() { generation++; lastRequest = -60_000L }
+    fun refresh(view: View) {
+        val elapsed = SystemClock.elapsedRealtime()
+        if (loading || elapsed - lastRequest < 60_000L) return
+        lastRequest = elapsed; loading = true
+        val token = generation
+        worker.execute {
+            val result = runCatching {
+                context.contentResolver.query(Uri.parse("content://dev.gtos.launcher.sky-state/state"),
+                    null, null, null, null)?.use { cursor ->
+                    if (!cursor.moveToFirst()) null else {
+                        val lat = cursor.getDouble(0); val lon = cursor.getDouble(1)
+                        if (!lat.isFinite() || !lon.isFinite() || lat !in -90.0..90.0 || lon !in -180.0..180.0) null
+                        else State(lat, lon, cursor.getLong(2))
+                    }
+                }
+            }.getOrNull()
+            view.post {
+                loading = false
+                if (token == generation && result != null) {
+                    state = result; minuteKey = -1L
+                    view.invalidate()
+                }
+            }
+        }
+    }
+
+    fun draw(canvas: Canvas, w: Float, h: Float, brightness: Float) {
+        if (w <= 0 || h <= 0) return
+        val now = System.currentTimeMillis()
+        val data = state
+        if (data != null && minuteKey != now / 60_000) {
+            minuteKey = now / 60_000
+            sun = SkyAstronomy.sun(now, data.latitude, data.longitude)
+            moon = SkyAstronomy.moon(now, data.latitude, data.longitude)
+        }
+        val isDay = sun?.let { it.altitude > 0 } ?: (java.time.LocalTime.now().hour in 6..19)
+        val t = (SystemClock.elapsedRealtimeNanos() - (data?.epoch ?: 0L)) / 1_000_000_000.0
+        paint.reset(); paint.isAntiAlias = true
+        val body = if (isDay) sun else moon?.position
+        if (body != null && body.altitude > 0) {
+            val x = w * (.12f + .76f * (1 - sin(body.azimuth * PI / 180).toFloat()) / 2)
+            val y = h * (.43f - body.altitude.toFloat().coerceIn(0f, 90f) / 90f * .32f)
+            val radius = w * if (isDay) .045f else .027f
+            val fade = (body.altitude / 3).coerceIn(0.0, 1.0).toFloat() * brightness
+            if (isDay) {
+                // Small bounded halo, with no full-screen ambient illumination.
+                paint.shader = RadialGradient(x, y, radius * 1.6f,
+                    intArrayOf(0x60FFE2AE, 0x00FFE2AE), null, Shader.TileMode.CLAMP)
+                paint.alpha = (fade * 255).toInt()
+                canvas.drawCircle(x, y, radius * 1.6f, paint)
+                paint.shader = null; paint.color = 0xFFFFE7BB.toInt(); paint.alpha = (fade * 255).toInt()
+                canvas.drawCircle(x, y, radius, paint)
+            } else moon?.let { drawMoon(canvas, x, y, radius, it, fade) }
+        }
+        val scale = w / 540f
+        if (isDay) {
+            if (t > 20 && (t - 20) % 50 < 10) {
+                val q = ((t - 20) % 50 / 10).toFloat()
+                val x = w * (-.05f + q * 1.1f); val y = h * (.65f - q * .4f)
+                paint.shader = LinearGradient(x - 90 * scale, y + 33 * scale, x, y,
+                    intArrayOf(0x00FFFFFF, 0xA6FFFFFF.toInt()), null, Shader.TileMode.CLAMP)
+                paint.alpha = (brightness * 255).toInt(); paint.strokeWidth = scale
+                canvas.drawLine(x - 90 * scale, y + 33 * scale, x, y, paint)
+                paint.shader = null; paint.color = Color.WHITE; paint.alpha = (brightness * 230).toInt()
+                path.reset(); path.moveTo(x + 5 * scale, y - 2 * scale); path.lineTo(x - 6 * scale, y - 2 * scale)
+                path.lineTo(x - scale, y + scale); path.lineTo(x - 2 * scale, y + 6 * scale)
+                path.lineTo(x + scale, y); path.close(); canvas.drawPath(path, paint)
+            }
+            return
+        }
+        paint.shader = null; paint.color = 0xFFF0F8FF.toInt()
+        for (star in stars) {
+            val twinkle = (.25 + .3 * sin(t * star[4] + star[3])).coerceAtLeast(.035)
+            paint.alpha = (twinkle * brightness * 255).toInt()
+            canvas.drawCircle(star[0] * w, star[1] * h, star[2] * scale, paint)
+        }
+        val cycle = SkyMeteor.cycle(t)
+        for (i in 0 until 1 + cycle % 2) {
+            val age = SkyMeteor.age(t, i) ?: continue
+            val star = stars[(cycle + i) % stars.size]
+            val flight = SkyMeteor.flight(w, h, age, star[0], (cycle + i) % 3 == 2)
+            val alpha = (flight.opacity * brightness * 230).toInt().coerceIn(0, 255)
+            paint.alpha = 255; paint.style = Paint.Style.STROKE; paint.strokeCap = Paint.Cap.ROUND
+            paint.shader = LinearGradient(flight.tailX, flight.tailY, flight.x, flight.y,
+                intArrayOf(0x00DDEEFF, (alpha shl 24) or 0xEAF4FF), null, Shader.TileMode.CLAMP)
+            paint.strokeWidth = 1.4f * scale
+            canvas.drawLine(flight.tailX, flight.tailY, flight.x, flight.y, paint)
+            paint.shader = null; paint.style = Paint.Style.FILL
+            paint.color = (alpha shl 24) or 0xF5FAFF
+            canvas.drawCircle(flight.x, flight.y, 1.15f * scale, paint)
+        }
+    }
+
+    private fun drawMoon(canvas: Canvas, x: Float, y: Float, radius: Float, moon: SkyAstronomy.Moon, opacity: Float) {
+        // Match Home's sphere lighting, terminator and restrained lunar texture.
+        if (moon.fraction < .002) return
+        val key = "${(moon.fraction * 10000).toInt()}:${(moon.limbAngle * 1000).toInt()}"
+        if (moonKey != key) {
+            moonKey = key
+            val size = 128; val pixels = IntArray(size * size)
+            val zLight = 2 * moon.fraction - 1
+            val lateral = sqrt((1 - zLight * zLight).coerceAtLeast(0.0))
+            val lx = sin(moon.limbAngle) * lateral; val ly = -cos(moon.limbAngle) * lateral
+            for (j in 0 until size) for (i in 0 until size) {
+                val nx = (i + .5 - size / 2) / (size / 2); val ny = (j + .5 - size / 2) / (size / 2)
+                val r2 = nx * nx + ny * ny
+                if (r2 >= 1) continue
+                val nz = sqrt(1 - r2)
+                val light = (nx * lx + ny * ly + nz * zLight).coerceAtLeast(0.0)
+                val texture = .94 + .025 * sin(nx * 4 + ny * 7) + .035 * cos(nx * 10 - ny * 3)
+                val value = ((.025 + .975 * sqrt(light)) * texture * 240).toInt().coerceIn(0, 255)
+                val alpha = ((1 - sqrt(r2)) * size).coerceIn(0.0, 1.0) * 255 * if (light > 0) 1.0 else .16
+                pixels[j * size + i] = Color.argb(alpha.toInt(), value, value, (value * 1.025).toInt().coerceAtMost(255))
+            }
+            moonBitmap?.recycle()
+            moonBitmap = Bitmap.createBitmap(pixels, size, size, Bitmap.Config.ARGB_8888)
+        }
+        paint.shader = null; paint.alpha = (opacity * 255).toInt()
+        rect.set(x - radius, y - radius, x + radius, y + radius)
+        moonBitmap?.let { canvas.drawBitmap(it, null, rect, paint) }
+    }
+
+    companion object { private val worker = Executors.newSingleThreadExecutor() }
+}
