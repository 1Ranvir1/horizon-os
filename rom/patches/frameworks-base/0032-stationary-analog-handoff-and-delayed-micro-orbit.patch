+/** Same Home geometry through the handoff; a small orbit resumes on native AOD ticks. */
+internal object GtosAnalogBurnIn {
+    fun progress(elapsedMillis: Long): Float {
+        val t = ((elapsedMillis - 30_000L) / 120_000f).coerceIn(0f, 1f)
+        return t * t * (3f - 2f * t)
+    }
+    fun offset(nativePixels: Int, progress: Float): Int =
+        (nativePixels.coerceIn(-6, 6) * progress.coerceIn(0f, 1f)).toInt()
+}
