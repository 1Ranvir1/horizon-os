+package com.android.systemui.shared.clocks.view
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.Shader
+import android.graphics.Typeface
+
+/** Paint treatment only. Native clock views retain their time and accessibility. */
+internal class GtosGlassClockPainter(context: Context) {
+    val enabled: Boolean = context.resources.getIdentifier("config_gtosGlassControls", "bool", context.packageName).let {
+        it != 0 && context.resources.getBoolean(it)
+    }
+    private val ctx = context
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        typeface = Typeface.create(Typeface.create("sans-serif-condensed", Typeface.NORMAL), 200, false)
+        textAlign = Paint.Align.CENTER
+    }
+    private var lastHeight = -1
+    private var lastTint = 0
+
+    fun draw(canvas: Canvas, text: String, width: Int, height: Int) {
+        if (width <= 0 || height <= 0 || text.isBlank()) return
+        val tint = ctx.getColor(android.R.color.system_accent1_100)
+        if (height != lastHeight || tint != lastTint) {
+            lastHeight = height
+            lastTint = tint
+            val soft = (tint and 0x00ffffff) or (180 shl 24)
+            paint.shader = LinearGradient(0f, 0f, 0f, height.toFloat(),
+                intArrayOf(0xf5ffffff.toInt(), soft, 0x85ffffff.toInt(), soft, 0xf0ffffff.toInt()),
+                floatArrayOf(0f, .25f, .48f, .75f, 1f), Shader.TileMode.CLAMP)
+        }
+        paint.textSize = height * .70f
+        val measured = paint.measureText(text)
+        if (measured > width * .94f) paint.textSize *= width * .94f / measured
+        val fontHeight = paint.fontMetrics.descent - paint.fontMetrics.ascent
+        val verticalScale = (height * .93f / fontHeight).coerceIn(1f, 2.7f)
+        val save = canvas.save()
+        canvas.scale(1f, verticalScale, width / 2f, height / 2f)
+        val baseline = height / 2f - (paint.fontMetrics.ascent + paint.fontMetrics.descent) / 2f
+        canvas.drawText(text, width / 2f, baseline, paint)
+        canvas.restoreToCount(save)
+    }
+}
